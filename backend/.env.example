# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root123456
DB_NAME=factory_management

# Redis配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis123456
REDIS_DB=0

# JWT配置
JWT_SECRET_KEY=your_jwt_secret_key_change_in_production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# 服务器配置
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=True

# OSS配置 (阿里云)
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_ACCESS_KEY_ID=your_access_key_id
OSS_ACCESS_KEY_SECRET=your_access_key_secret
OSS_BUCKET_NAME=your_bucket_name

# 消息队列配置 (RabbitMQ)
MQ_HOST=localhost
MQ_PORT=5672
MQ_USER=admin
MQ_PASSWORD=admin123456
MQ_VHOST=/

# AI解析配置
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini

# ncloud2API / ERP集成配置
ERP_BASE_URL=http://127.0.0.1:8001
ERP_USERNAME=
ERP_PASSWORD=
ERP_QR_IMAGE_PATH=
ERP_DEFAULT_SALESPERSON=
ERP_DEFAULT_CUSTOMER_TYPE=
ERP_DEFAULT_CURRENCY=人民币
ERP_DEFAULT_BRAND=
ERP_DEFAULT_SHIPPING_METHOD=
